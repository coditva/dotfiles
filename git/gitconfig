[user]
	name = Utkarsh Maheshwari
	email = coditva@gmail.com
	signingkey = 62CB3E5A978B4F0B
[core]
	editor = nvim
	excludesfile = /home/me/.gitignore
[http]
	sslVerify = true
[push]
	default = current
[credential]
	helper = osxkeychain
[color]
	ui = auto
[diff]
	tool = vimdiff
[merge]
	tool = vimdiff
[commit]
	gpgsign = true
	verbose = true
[gpg]
	program = gpg
[grep]
	lineNumber = true
[rerere]
	enabled = false
[rebase]
	autoStash = true
[pull]
	rebase = true
[branch]
	autosetupmerge = always
	autosetuprebase = always
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
